# Settings for the live site. No secrets belong in this file.

# The Cloud Run address of the website this one replaces (ends in .run.app, never www.taxstreem.com).
# Sign-up, privacy, terms and The Bridge are still served from it. deploy.sh stops if this is empty.
LEGACY_SITE_URL=

# Where articles, videos, press items and events are read from.
CMS_URL=https://taxstreem-cms-backend-61341992308.us-central1.run.app

# Where the newsletter and contact forms are sent. Staff read them in the admin portal.
NEXT_PUBLIC_API_URL=https://internal-core-api.taxstreem.com/api/v1
